# Relaxations layered on top of the JDK's stock java.security.
#
# This file is applied with -Djava.security.properties=<file>, which MERGES
# these keys over the JDK's master lib/security/java.security. That master
# file must stay in place: it is what sets security.overridePropertiesFile=true,
# and without it this file is silently ignored entirely.
#
# Do NOT re-declare security.provider.N here. The stock list already contains
# SunEC and SunJSSE in the right order, and overriding the slots is how the
# JSSE provider previously got dropped (leaving the JVM with no TLS at all).
#
# The point of these three keys is to let the legacy Avocent client negotiate
# with old iDRAC7 firmware: modern JDK 8 builds disable TLSv1/TLSv1.1, 3DES and
# plain ECDH outright, which that firmware still requires.
jdk.certpath.disabledAlgorithms=MD2, MD5, RSA keySize < 512
jdk.jar.disabledAlgorithms=MD2, MD5, RSA keySize < 512
jdk.tls.disabledAlgorithms=SSLv3, RC4, DES, MD5withRSA, DH keySize < 1024, EC keySize < 224
